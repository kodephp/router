{
  "ignorePatterns": [
    {
      "pattern": "^https://github.com/.*"
    },
    {
      "pattern": "^https://packagist.org/.*"
    }
  ],
  "httpHeaders": [
    {
      "name": "User-Agent",
      "value": "Mozilla/5.0 (compatible; Markdown Link Check/1.0)"
    }
  ],
  "timeout": "20s",
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 203, 206, 301, 302, 303, 307, 308]
}
