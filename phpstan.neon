parameters:
    level: 8
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        - '#^Method FastRoute\\\\Dispatcher\\\\GroupCountBased\(\) has no return type specified.$#'
        # 软依赖：kode/context 未安装时属于 unknown class，运行期已用 class_exists 守卫
        - '#Call to static method .+ on an unknown class Kode#i'
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
